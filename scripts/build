#!/usr/bin/env bash
# Build the site from site/ into $1 (default _site/): copy everything, then render each
# Markdown file and Jupyter notebook to an HTML page beside it (the .ipynb stays for download).
# Files under a download/ folder are served as is, so a document can offer its own source.
# library/index.html and explainers/index.html are generated from the front matter of the pages below them.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
"$root/scripts/check-clone" --ci-ok
out=${1:-$root/_site}

rm -rf "$out"
cp -r "$root/site" "$out"
rm -f "$out/.gitkeep"

# Section indexes: one entry per <section>/<slug>/index.md, newest first, from the front matter.
# A folder holding no index.md of its own is skipped.
section_index() {  # <folder> <title> <intro>
  local dir=$out/$1 meta slug date title lang summary lang_attr lang_tag language
  [ -d "$dir" ] || return 0
  meta=$(mktemp)
  printf '%s' '$date$	$title$	$if(lang)$$lang$$else$en$endif$	$summary$' > "$meta"
  {
    printf -- '---\ntitle: %s\npagetitle: %s\nsummary: "%s"\ncrumbs:\n  href: ../index.html\n  label: Home\n---\n\n' "$2" "$2" "$3"
    printf '%s\n\n' "$3"
    printf '<ul class="library">\n'
    for doc in "$dir"/*/index.md; do
      [ -e "$doc" ] || continue
      slug=$(basename "$(dirname "$doc")")
      # The moved-page alias must stay reachable without becoming a Library entry.
      [ "$1/$slug" = library/ai-safety-seminar-1 ] && continue
      IFS=$'\t' read -r date title lang summary < <(pandoc "$doc" -t plain --wrap=none --template="$meta" | tr '\n' ' ' | sed 's/ *$//'; echo)
      lang_attr= lang_tag=
      if [ "$lang" != en ]; then
        case $lang in cs) language=Czech ;; *) language=$lang ;; esac
        lang_attr=" lang=\"$lang\""
        lang_tag=" <span class=\"language\" lang=\"en\">$language</span>"
      fi
      printf '%s\t<li%s><a href="%s/index.html"><strong>%s</strong></a> <span class="date">· %s</span>%s<span class="summary">%s</span></li>\n' \
        "$date" "$lang_attr" "$slug" "$title" "$date" "$lang_tag" "$summary"
    done | sort -r | cut -f2-
    printf '</ul>\n'
  } > "$dir/index.md"
  rm -f "$meta"
}
section_index library Library \
  'Longer documents: study guides, digests and preparation notes, each readable here, with EPUB, PDF or Markdown downloads where available.'
section_index explainers Explainers \
  'Explanations of books, concepts and facts: each takes a source and works through it with examples, adding what the source leaves out. Readable here and downloadable as EPUB, PDF or Markdown.'

find "$out" -type f \( -name '*.md' -o -name '*.ipynb' \) -not -path '*/download/*' -print0 |
while IFS= read -r -d '' src; do
  html=${src%.*}.html
  page_type=article
  for child in "$(dirname "$src")"/*/index.{md,html}; do
    if [ -f "$child" ]; then page_type=website; break; fi
  done
  pandoc "$src" --standalone --math-method=mathml --wrap=none \
    --template="$root/scripts/template.html" --toc --toc-depth=2 \
    --metadata=site-title:"Jaromír Svoboda" \
    --metadata=og-type:"$page_type" \
    --lua-filter="$root/scripts/md-links.lua" -o "$html"
  case $src in *.md) rm "$src" ;; esac
  echo "built ${html#"$out"/}"
done

python3 "$root/scripts/postprocess.py" "$out"
