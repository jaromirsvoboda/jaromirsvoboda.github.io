# Generic leak patterns (public). Site-specific names live in a private list;
# see scripts/leak-scan.

# Tailscale addresses (100.64/10) and tailnet host names
\b100\.(6[4-9]|[7-9]\d|1[01]\d|12[0-7])\.\d{1,3}\.\d{1,3}\b
\.ts\.net\b
# private network addresses
\b10\.\d{1,3}\.\d{1,3}\.\d{1,3}\b
\b172\.(1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3}\b
\b192\.168\.\d{1,3}\.\d{1,3}\b
# home directories
/home/[a-z_][a-z0-9_-]*/
[A-Z]:\\Users\\[^\\\s]+
# e-mail addresses (but not git@host: remotes, noreply@ senders or GitHub's noreply addresses)
(?<![\w.%+-])(?!git@|noreply@)[\w.%+-]+@(?!users\.noreply\.github\.com\b)[\w-]+(\.[\w-]+)*\.[a-z]{2,}\b
